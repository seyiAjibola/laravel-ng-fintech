{
    "name": "seyiajibola/laravel-ng-fintech",
    "description": "A Laravel package for integrating Nigerian fintech APIs — payments, airtime, bills, identity, and more.",
    "keywords": ["laravel", "fintech", "nigeria", "paystack", "flutterwave", "vtpass", "airtime"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Seyi Ajibola Ojo",
            "email": "info2mee.seyi@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "*",
        "mockery/mockery": "^1.6",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "SeyiAjibola\\NgFintech\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeyiAjibola\\NgFintech\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SeyiAjibola\\NgFintech\\Services\\FintechServiceProvider"
            ],
            "aliases": {
                "NgFintech": "SeyiAjibola\\NgFintech\\Facades\\NgFintech",
                "NgPayment": "SeyiAjibola\\NgFintech\\Facades\\Payment",
                "NgAirtime": "SeyiAjibola\\NgFintech\\Facades\\Airtime",
                "NgBills": "SeyiAjibola\\NgFintech\\Facades\\Bills",
                "NgIdentity": "SeyiAjibola\\NgFintech\\Facades\\Identity"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
